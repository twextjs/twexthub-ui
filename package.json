{
  "name": "@twextjs/twexthub-ui",
  "private": true,
  "version": "1.0.0",
  "description": "The official web frontend for TwextHub, the registry of Twext-compiled TurboWarp extensions.",
  "type": "module",
  "author": "Twext Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twextjs/twexthub-ui.git"
  },
  "bugs": {
    "url": "https://github.com/twextjs/twexthub-ui/issues"
  },
  "homepage": "https://github.com/twextjs/twexthub-ui#readme",
  "scripts": {
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "doctoc": "doctoc --notitle .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.51.0",
    "motion": "^14.0.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lifelinejs/lifeline": "^0.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "doctoc": "^2.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "monaco-editor": "^0.57.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "turbowarp",
    "turbowarp-extension",
    "scratch",
    "scratch-extension",
    "twext",
    "twexthub",
    "registry"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
